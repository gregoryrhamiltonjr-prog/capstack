# ── Core ──────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-secret"

# App URL (required in production for OAuth callbacks)
AUTH_URL="http://localhost:3000"
# NEXTAUTH_URL is accepted as an alias by Auth.js
# NEXTAUTH_URL="http://localhost:3000"

# ── Database ──────────────────────────────────────────
# Local SQLite
DATABASE_URL="file:./dev.db"
# Production Postgres example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/capstack?sslmode=require"

# ── Google OAuth ──────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Apple Sign In ─────────────────────────────────────
# https://developer.apple.com/account/resources/identifiers
# Redirect URI: {AUTH_URL}/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ── Stripe (subscription: $12.99/mo, 3-day trial) ─────
# https://dashboard.stripe.com/apikeys
# Billing is only enforced when STRIPE_SECRET_KEY and STRIPE_PRICE_ID are set;
# leave blank in local dev to keep the app fully open.
STRIPE_SECRET_KEY=""
# Recurring price ($12.99/month) created in the Stripe dashboard → Products.
STRIPE_PRICE_ID=""
# From `stripe listen` (local) or the dashboard webhook endpoint (prod).
# Endpoint URL: {AUTH_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
