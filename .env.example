# Copy to .env and fill in real values.
# Never commit .env.

# SQLite (local / simple deploys)
DATABASE_URL="file:./dev.db"

# For Postgres (recommended in production), use something like:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/capstack?sslmode=require"

# Required in production — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-secret"
